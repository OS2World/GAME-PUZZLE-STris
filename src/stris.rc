/*******************************************************************************
*                                                                             *
* STRIS.RC                                                                    *
* -------                                                                    *
*                                                                             *
* Resource compiler file for STris.                                           *
*                                                                             *
* Modification History:                                                       *
* ---------------------                                                       *
*                                                                             *
* 14.04.95  RHS  Created this file.                                          *
* 22.04.95  RHS  1. Rework.                                                  *
* 2026      OD2  Standardized menu structure (Game/Options/Detail/Language/  *
*                Help), standard accelerators (Ctrl+N/P/Q/X/B/F),            *
*                standard about dialog, BLDLEVEL record.                     *
*                                                                             *
********************************************************************************/

#include <os2.h>
#include "stris_id.h"
#include "help.h"


/*******************************************************************************
* BLDLEVEL record (readable with bldlevel.exe / REXX bldlevel())
*******************************************************************************/

RCDATA ID_BLDLEVEL
{
    "@#Rene Straub:1.50#@##1## 09 Oct 2026 12:00:00      ARCAOS:::0::::@@STris for OS/2 - classic Tetris puzzle game"
}


/*******************************************************************************
* Menu bar. The menu items are re-labelled at runtime (set_language) so the
* texts here are only placeholders. The cascade SUBMENU ids are needed for
* the runtime re-labelling.
*******************************************************************************/

MENU PrgMenu PRELOAD MOVEABLE
BEGIN
    SUBMENU "~Game", IDM_SUBMENU_GAME
    BEGIN
        MENUITEM "~New Game\tCtrl+N",       IDM_NEW
        MENUITEM "~Pause Game\tCtrl+P",     IDM_PAUSE
        MENUITEM "~Quit Game\tCtrl+Q",      IDM_QUIT, , MIA_DISABLED
        MENUITEM SEPARATOR
        MENUITEM "E~xit\tCtrl+X",           IDM_EXIT
    END

    SUBMENU "~Options", IDM_SUBMENU_OPTIONS
    BEGIN
        MENUITEM "~Settings...",            IDM_SETTINGS
        MENUITEM "Define ~Keys...",         IDM_KEYS
        MENUITEM "~Hiscore...",             IDM_HISCORE_MENU
        MENUITEM SEPARATOR
        SUBMENU "~Detail", IDM_SUBMENU_DETAIL
        BEGIN
            MENUITEM "~High",               IDM_HIGHDET
            MENUITEM "~Medium",             IDM_MEDIUMDET
            MENUITEM "~Low",                IDM_LOWDET
        END
        MENUITEM SEPARATOR
        SUBMENU "~Language", IDM_SUBMENU_LANGUAGE
        BEGIN
            MENUITEM "~English",            IDM_LANG_EN
            MENUITEM "~Espanol",            IDM_LANG_ES
            MENUITEM "~Nederlands",         IDM_LANG_NL
            MENUITEM "~Deutsch",            IDM_LANG_DE
            MENUITEM "~Francais",           IDM_LANG_FR
            MENUITEM "~Italiano",           IDM_LANG_IT
        END
        MENUITEM SEPARATOR
        MENUITEM "~Background Run\tCtrl+B", IDM_BACKGRND
        MENUITEM "~Frame Controls\tCtrl+F", IDM_FRAME
        MENUITEM SEPARATOR
        MENUITEM "Save settings on e~xit",  IDM_SAVEONEXIT
    END

    SUBMENU "~Help", IDM_SUBMENU_HELP
    BEGIN
        MENUITEM "~Using Help",             IDM_HELPUSING, , MIA_DISABLED
        MENUITEM "~Contents",               IDM_HELPCONTENTS, , MIA_DISABLED
        MENUITEM "Help ~Index",             IDM_HELPINDEX, , MIA_DISABLED
        MENUITEM "~How to play",            IDM_HELPHOWTOPLAY, , MIA_DISABLED
        MENUITEM "~Keys",                   IDM_HELPKEYS, , MIA_DISABLED
        MENUITEM SEPARATOR
        MENUITEM "~About STris...",         IDM_ABOUT_MENU
    END
END


/*******************************************************************************
* Accelerator table. Letter accelerators are registered for both cases.
*******************************************************************************/

ACCELTABLE PrgAccel PRELOAD
BEGIN
    "n",   IDM_NEW,      CONTROL
    "N",   IDM_NEW,      CONTROL
    "p",   IDM_PAUSE,    CONTROL
    "P",   IDM_PAUSE,    CONTROL
    "q",   IDM_QUIT,     CONTROL
    "Q",   IDM_QUIT,     CONTROL
    "x",   IDM_EXIT,     CONTROL
    "X",   IDM_EXIT,     CONTROL
    "b",   IDM_BACKGRND, CONTROL
    "B",   IDM_BACKGRND, CONTROL
    "f",   IDM_FRAME,    CONTROL
    "F",   IDM_FRAME,    CONTROL
    VK_PAUSE, IDM_PAUSE, VIRTUALKEY
END


/*******************************************************************************
 * Help table.
 * NOTE: The Open Watcom resource compiler (wrc 2.0.1) cannot serialize an
 * OS/2 HELPITEM/HELPSUBTABLE resource correctly - a non-empty subtable
 * poisons the bind (the resulting .exe has a zero-byte resource object and
 * the loader rejects it with SYS0193).  The OS/2 help manager therefore
 * does NOT get a module-level help table here.  F1 / the Help buttons of the
 * dialogs are dispatched by the application's own WM_HELP handlers
 * (HelpMain, HelpKeys, HelpHowToPlay, HelpIndex, HelpContents, HelpForHelp)
 * which call WinHelp(HM_DISPLAY_HELP, panelID, HM_RESOURCEID) directly.
 * The panel ids (HELP_GENERAL, HELP_KEYS, ...) live in stris_id.h and are
 * authored in the per-language IPF libraries.
 *******************************************************************************/


/*******************************************************************************
* About dialog (standard, not translated).
*******************************************************************************/

DLGTEMPLATE DLG_ABOUT PRELOAD MOVEABLE DISCARDABLE
BEGIN
    DIALOG "About STris", DLG_ABOUT, 32, 24, 240, 110,, FCF_TITLEBAR|FCF_DLGBORDER
    BEGIN
        CTEXT "STris for OS/2",                 -1, 10, 90, 220, 8
        CTEXT "Version 1.50",                   -1, 10, 78, 220, 8
        CTEXT "OpenWatcom Release",             -1, 10, 66, 220, 8
        CTEXT "(c) 1995, 1996, Rene Straub",    -1, 10, 54, 220, 8
        CTEXT "(c) 2026, OS2World",             -1, 10, 42, 220, 8
        CTEXT "GNU GPL V3",                     -1, 10, 30, 220, 8
        DEFPUSHBUTTON "Close", DID_OK,           98, 10, 44, 14, WS_GROUP
    END
END


/*******************************************************************************
* Enter-name dialog (shown after a new hiscore)
*******************************************************************************/

DLGTEMPLATE DLG_ENTERNAME PRELOAD MOVEABLE DISCARDABLE
BEGIN
    DIALOG "STris - New Hiscore", DLG_ENTERNAME, 13, 160, 194, 83,, FCF_SYSMENU|FCF_TITLEBAR
    BEGIN
        DEFPUSHBUTTON "~OK", DID_OK, 72, 5, 50, 14
        CONTROL "~Help", IDD_HELP, 132, 5, 50, 14, "#3", BS_PUSHBUTTON|BS_HELP|WS_VISIBLE|WS_GROUP|WS_TABSTOP

        CONTROL "", IDD_TEXT_FIELD, 13, 27, 168, 9, "#6", ES_CENTER|ES_AUTOSCROLL|ES_MARGIN|WS_VISIBLE|WS_GROUP|WS_TABSTOP
        CONTROL "Congratulations you are one", DIA_CONG_T1, 48, 66, 136, 8, "#5", SS_TEXT|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP
        CONTROL "of the best STris players.",  DIA_CONG_T2, 48, 58, 136, 8, "#5", SS_TEXT|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP
        CONTROL "Please enter your name right here...", DIA_NAME_PROMPT, 12, 41, 168, 8, "#5", SS_TEXT|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP
    END
END


