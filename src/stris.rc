/*******************************************************************************
* Options dialog
*******************************************************************************/

DLGTEMPLATE DLG_OPTIONS PRELOAD MOVEABLE DISCARDABLE
BEGIN
    DIALOG "STris - Options", DLG_OPTIONS, 51, 86, 216, 148,, FCF_SYSMENU|FCF_TITLEBAR
    BEGIN
        DEFPUSHBUTTON "~OK", DID_OK, 8, 4, 51, 14
        PUSHBUTTON "~Cancel", DID_CANCEL, 64, 4, 51, 14
        CONTROL "~Help", IDD_HELP, 158, 4, 50, 14, "#3", BS_PUSHBUTTON|BS_HELP|WS_VISIBLE|WS_GROUP|WS_TABSTOP

        CONTROL "Settings", GB_SETTINGS, 8, 80, 200, 64, "#5", SS_GROUPBOX|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP
            PRESPARAMS PP_FONTNAMESIZE "10.Helv Bold"

            CONTROL "~Sound", IDD_SOUND, 16, 124, 50, 10, "#3", BS_AUTOCHECKBOX | WS_VISIBLE | WS_GROUP | WS_TABSTOP
            CONTROL "~Grid", IDD_GRID, 16, 114, 50, 10, "#3", BS_AUTOCHECKBOX | WS_VISIBLE | WS_GROUP | WS_TABSTOP
            CONTROL "~Next Piece", IDD_NEXTPIECE, 16, 104, 88, 10, "#3", BS_AUTOCHECKBOX | WS_VISIBLE | WS_GROUP | WS_TABSTOP
            CONTROL "~Rotate clockwise", IDD_ROTATE, 16, 94, 100, 10, "#3", BS_AUTOCHECKBOX | WS_VISIBLE | WS_GROUP | WS_TABSTOP
            CONTROL "Remain ~paused", IDD_REMAINPAUSED, 16, 84, 100, 10, "#3", BS_AUTOCHECKBOX | WS_VISIBLE | WS_GROUP | WS_TABSTOP

            CONTROL "", IDD_PALETTE, 116, 112, 80, 12, "#32", SPBS_MASTER | SPBS_READONLY | SPBS_JUSTLEFT | SPBS_FASTSPIN | WS_VISIBLE | WS_GROUP | WS_TABSTOP
            CONTROL "Palette", DLG_PALETTE, 116, 126, 45, 8, "#5", SS_TEXT | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
            CONTROL "So~lid colors", IDD_SOLID, 116, 100, 80, 10, "#3", BS_AUTOCHECKBOX | WS_VISIBLE | WS_GROUP | WS_TABSTOP

        CONTROL "Difficulty", GB_DIFFICULTY, 8, 26, 200, 50, "#5", SS_GROUPBOX | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
            PRESPARAMS PP_FONTNAMESIZE "10.Helv Bold"

            CONTROL "", IDD_SPEEDSLIDER, 16, 54, 77, 8, "#8", WS_VISIBLE | WS_GROUP | WS_TABSTOP
            CONTROL "", IDD_LEVELSLIDER, 16, 42, 77, 8, "#8", WS_VISIBLE | WS_GROUP | WS_TABSTOP
            CONTROL "Speed", DLG_SPEED, 120, 54, 45, 8, "#5", SS_TEXT | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
            CONTROL "Startlevel", DLG_STARTLEVEL, 120, 42, 45, 8, "#5", SS_TEXT | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
            CONTROL "1", IDD_SPEEDTEXT, 96, 54, 13, 8, "#5", SS_TEXT | DT_RIGHT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
            CONTROL "2", IDD_LEVELTEXT, 96, 42, 13, 8, "#5", SS_TEXT | DT_RIGHT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
            CONTROL "Start with ~extra squares", IDD_EXTRASQUARES, 16, 30, 160, 10, "#3", BS_AUTOCHECKBOX | WS_VISIBLE | WS_GROUP | WS_TABSTOP
    END
END


/*******************************************************************************
* Key dialog
*******************************************************************************/

DLGTEMPLATE DLG_KEY PRELOAD MOVEABLE DISCARDABLE
BEGIN
    DIALOG "STris - Key Bindings", DLG_KEY, 51, 86, 240, 110,, FCF_SYSMENU|FCF_TITLEBAR
    BEGIN
        DEFPUSHBUTTON "~OK", DID_OK, 8, 4, 44, 14
        PUSHBUTTON "~Cancel", DID_CANCEL, 56, 4, 44, 14
        PUSHBUTTON "~Default", IDD_DEFAULT, 104, 4, 44, 14
        CONTROL "~Help", IDD_HELP, 188, 4, 44, 14, "#3", BS_PUSHBUTTON|BS_HELP|WS_VISIBLE|WS_GROUP|WS_TABSTOP

        CONTROL "Keys", GB_KEYS, 8, 24, 224, 82, "#5", SS_GROUPBOX | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
            PRESPARAMS PP_FONTNAMESIZE "10.Helv Bold"

            PUSHBUTTON "<", IDD_KEYLEFT,     18, 80, 20, 14
            PUSHBUTTON ">", IDD_KEYRIGHT,    18, 65, 20, 14
            PUSHBUTTON "v", IDD_KEYDROP,     18, 50, 20, 14
            PUSHBUTTON "+", IDD_KEYROTATE,  124, 80, 20, 14
            PUSHBUTTON "-", IDD_KEYROTATE2, 124, 65, 20, 14

            CONTROL "CURSOR LEFT", IDD_TEXTLEFT, 46,77,70,14, "#5", SS_TEXT|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP
            CONTROL "CURSOR RIGHT", IDD_TEXTRIGHT,46,62,70,14, "#5", SS_TEXT|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP
            CONTROL "CURSOR DOWN", IDD_TEXTDROP, 46,47,70,14, "#5", SS_TEXT|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP
            CONTROL "CURSOR UP", IDD_TEXTROTATE,  152,77,70,14, "#5", SS_TEXT|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP
            CONTROL "<none>", IDD_TEXTROTATE2,     152,62,70,14, "#5", SS_TEXT|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP

            CONTROL "Select the function you wish to change.", IDD_KEYTEXT1, 18,36,200,8, "#5", SS_TEXT|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP
                PRESPARAMS PP_FONTNAMESIZE "8.Helv"

            CONTROL "", IDD_KEYTEXT2, 18,28,200,8, "#5", SS_TEXT|DT_LEFT|DT_TOP|DT_MNEMONIC|WS_VISIBLE|WS_GROUP
                PRESPARAMS PP_FONTNAMESIZE "8.Helv"
                PRESPARAMS PP_FOREGROUNDCOLOR 0xFF0000
    END
END


